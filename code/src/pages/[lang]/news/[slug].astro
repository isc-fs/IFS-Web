---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import styles from '../../../styles/pages/article.module.css';
import { type Lang, useTranslations, path } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => {
    const [lang, file] = post.id.split('/');
    return {
      params: { lang, slug: file.replace(/\.md$/, '') },
      props: { post }
    };
  });
}

interface Props {
  post: CollectionEntry<'news'>;
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await post.render();

const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<Base
  lang={lang}
  current="news"
  self="/news"
  title={`${post.data.title} · ISC Formula Student`}
  description={post.data.excerpt}
>
  <article>
    <header class={styles.header}>
      <div class={`wrap ${styles.measure}`}>
        <div class={styles.metaRow}>
          <span class="badge badge-gold">{post.data.category}</span>
          <span class="mono caption muted">{fmt.format(post.data.date)}</span>
        </div>
        <h1 class="heading h1 mb-5">{post.data.title}</h1>
        <hr class="rule rule-lg" />
        {post.data.excerpt && <p class="lead">{post.data.excerpt}</p>}
      </div>
    </header>

    {post.data.image && (
      <div class={`wrap ${styles.figure}`}>
        <img src={post.data.image} alt={post.data.title} class={styles.image} />
      </div>
    )}

    <div class={`wrap ${styles.bodyWrap}`}>
      <div class="prose">
        <Content />
      </div>
      <p class={styles.back}>
        <a href={path(lang, '/news')} class="link-rule">{t.news.archive}</a>
      </p>
    </div>
  </article>
</Base>
