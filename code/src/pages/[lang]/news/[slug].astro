---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { type Lang, useTranslations, path } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => {
    const [lang, file] = post.id.split('/');
    return {
      params: { lang, slug: file.replace(/\.md$/, '') },
      props: { post }
    };
  });
}

interface Props {
  post: CollectionEntry<'news'>;
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await post.render();

const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<Base
  lang={lang}
  current="news"
  self="/news"
  title={`${post.data.title} · ISC Formula Student`}
  description={post.data.excerpt}
>
  <article>
    <header style="padding:96px 0 40px">
      <div class="wrap" style="max-width:840px">
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px">
          <span class="badge badge-gold">{post.data.category}</span>
          <span class="mono caption" style="color:rgba(255,255,255,.6)">{fmt.format(post.data.date)}</span>
        </div>
        <h1 class="heading h1" style="margin-bottom:20px">{post.data.title}</h1>
        <hr class="rule rule-lg" />
        {post.data.excerpt && <p class="lead" style="color:rgba(255,255,255,.84)">{post.data.excerpt}</p>}
      </div>
    </header>

    {post.data.image && (
      <div class="wrap" style="margin-bottom:48px">
        <img src={post.data.image} alt={post.data.title} style="width:100%;height:auto" />
      </div>
    )}

    <div class="wrap" style="max-width:840px;padding-bottom:96px">
      <div class="prose" style="color:rgba(255,255,255,.84)">
        <Content />
      </div>
      <p style="margin-top:48px">
        <a href={path(lang, '/news')} class="link-rule">{t.news.archive}</a>
      </p>
    </div>
  </article>
</Base>
