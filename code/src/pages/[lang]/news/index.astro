---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import styles from '../../../styles/pages/news.module.css';
import { type Lang, useTranslations, path, languages } from '../../../i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const all = await getCollection('news', ({ id }) => id.startsWith(`${lang}/`));
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(`${lang}/`, '').replace(/\.md$/, '');
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
const fmtShort = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
});

const featured = sorted.find((p) => p.data.kind === 'featured') ?? sorted[0];
const cards = sorted.filter((p) => p.data.kind === 'card');
const briefs = sorted.filter((p) => p.data.kind === 'brief');
---

<Base
  lang={lang}
  current="news"
  self="/news"
  title={`${t.nav.news} · ISC Formula Student`}
  description={t.news.heroLead}
>
  <section class={styles.newsHero}>
    <div class="wrap">
      <p class="eyebrow">{t.news.heroEyebrow}</p>
      <h1 class="heading display-l mb-5">{t.news.heroTitle}</h1>
      <hr class="rule rule-lg" />
      <p class={`lead ${styles.heroLead}`}>{t.news.heroLead}</p>
      {/*
        These were pill-shaped outlined badges sitting exactly where filters
        belong, on a site that ships no JavaScript — they looked like controls
        and did nothing. Rendered as a category legend instead: same
        information, no false affordance.
      */}
      <ul class={styles.categories}>
        {t.news.categories.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  {featured && (
    <section class={styles.featuredSection}>
      <div class="wrap">
        <div class={styles.featured}>
          <div
            class={styles.featuredPhoto}
            style={`--photo:url('${featured.data.image ?? '/assets/car-cornering.jpg'}')`}
            role="img"
            aria-label={featured.data.title}
          />
          <div class={styles.featuredBody}>
            <div class={styles.meta}>
              <span class="badge badge-gold">{featured.data.category}</span>
              <span class={`${styles.metaDate} mono`}>{fmt.format(featured.data.date)}</span>
            </div>
            <h2 class="heading h1 mb-4">{featured.data.title}</h2>
            <p class="body mb-6">{featured.data.excerpt}</p>
            <a href={path(lang, `/news/${slugOf(featured.id)}`)} class={`link-rule ${styles.readMore}`}>{t.news.readMore}</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class={styles.gridSection}>
    <div class="wrap">
      <div class={styles.grid}>
        {cards.length === 0 && <p class={styles.empty}>{t.news.empty}</p>}
        {cards.map((post) => (
          <article class={styles.card} style={`--span:${post.data.span ?? 2}`}>
            <div
              class={styles.cardPhoto}
              style={`--photo-h:${(post.data.span ?? 2) >= 3 ? 260 : 200}px;--photo:url('${post.data.image ?? '/assets/car-paddock.jpg'}')`}
              role="img"
              aria-label={post.data.title}
            />
            <div class={styles.cardBody}>
              <div class={`${styles.meta} mb-4`}>
                <span class="badge badge-outline">{post.data.category}</span>
                <span class={`${styles.metaDate} mono`}>{fmt.format(post.data.date)}</span>
              </div>
              <h3 class="heading h3 mb-3">{post.data.title}</h3>
              <p class="body small muted mb-5">{post.data.excerpt}</p>
              <a href={path(lang, `/news/${slugOf(post.id)}`)} class={`link-rule ${styles.cardLink}`}>{t.news.readMore}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class={styles.briefs}>
    <div class="wrap">
      <div class={styles.briefsHead}>
        <h2 class="heading h2 flush">{t.news.briefsTitle}</h2>
        <a href={path(lang, '/news')} class={`link-rule ${styles.archiveLink}`}>{t.news.archive}</a>
      </div>
      {briefs.length === 0 && <p class={styles.empty}>{t.news.empty}</p>}
      {briefs.map((post) => (
        <a class={styles.brief} href={path(lang, `/news/${slugOf(post.id)}`)}>
          <span class={`${styles.briefDate} mono`}>{fmtShort.format(post.data.date)}</span>
          <span class={styles.briefTitle}>{post.data.title}</span>
          <span class={styles.briefCat}>{post.data.category}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
