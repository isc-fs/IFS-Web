---
import styles from './PageHero.module.css';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: string;
  /** CSS min-height, e.g. '80vh' */
  height?: string;
  /** background-position */
  focus?: string;
  /** Overlay gradient angle in degrees */
  angle?: number;
  size?: 'xl' | 'l';
  rule?: boolean;
}

const {
  eyebrow,
  title,
  lead,
  image,
  height = '52vh',
  focus = '50% 45%',
  angle = 90,
  size = 'l',
  rule = false
} = Astro.props;

/*
  Passed as custom properties rather than a finished background declaration.
  The scrim is directional, and on a narrow viewport the copy spans the full
  width and runs past the opaque end into the thin end — so the final stop has
  to be reachable from a media query, which an inline background is not.
*/
const vars = [
  `--hero-min-h:${height}`,
  `--hero-angle:${angle}deg`,
  `--hero-focus:${focus}`,
  `--hero-image:url('${image}')`
].join(';');
---

<section class={styles.hero} style={vars}>
  <div class={`wrap ${styles.inner}`}>
    <p class="eyebrow">{eyebrow}</p>
    <h1 class={`heading ${size === 'xl' ? 'display-xl' : 'display-l'} ${styles.title}`}>{title}</h1>
    {rule && <hr class="rule rule-lg" />}
    {lead && <p class={styles.lead}>{lead}</p>}
    <slot />
  </div>
</section>
